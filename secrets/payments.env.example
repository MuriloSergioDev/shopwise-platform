# Copy to secrets/payments.env (gitignored) and fill in your Stripe TEST-mode keys (dashboard.stripe.com/test/apikeys).
# Tilt turns it into the payments-secrets Secret, which every payments pod loads as env vars.
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
# Printed by `stripe listen` (the stripe-listen resource in Tilt): "Your webhook signing secret is whsec_...".
STRIPE_WEBHOOK_SECRET=whsec_...
